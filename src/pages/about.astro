---
import PageLayout from '../layouts/PageLayout.astro';
import SkillGrid from '../components/SkillGrid.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ContactLinks from '../components/ContactLinks.astro';
import IconLinkedin from '../components/icons/IconLinkedin.astro';
---

<PageLayout title="About">
  <div class="space-y-12">

    <!-- whoami -->
    <section>
      <h2 class="text-2xl font-black mb-4 pb-3 border-b border-border">whoami.</h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p>
          I was born in Nuoro (<span class="italic border-b border-dashed border-current" title="Nùoro">/ˈnu.oro/</span>),
          Sardinia, in <strong class="text-foreground">1989</strong>. I grew up in Orosei and, after finishing high
          school, moved first to Pisa and then to Cagliari, where I currently live and work.
        </p>
        <p>
          I'm a naturally curious person — I like understanding how things work, whether it's a system, a tool, or an
          idea. I've loved technology for as long as I can remember. Growing up, I split my time between playing
          outside and gaming sessions on my Super Nintendo, and it was that early passion for video games that
          eventually led me to programming. For me, writing code has always been a form of <strong class="text-foreground">craft</strong> —
          a way to build things that are both functional and purposeful.
        </p>
        <p>
          Outside of work, I spend my time hiking, climbing, running, and reading. I occasionally pick up the guitar
          or blow the dust off my Nintendo Switch.
        </p>
      </div>
    </section>

    <!-- skills -->
    <section>
      <h2 class="text-2xl font-black mb-4 pb-3 border-b border-border">tech skills.</h2>
      <p class="text-muted-foreground mb-6 leading-relaxed">
        Technologies I've worked with and built things with over the years.
      </p>
      <SkillGrid />
    </section>

    <!-- experience -->
    <section>
      <div class="flex flex-wrap items-center justify-between gap-4 pb-3 mb-6 border-b border-border">
        <h2 class="text-2xl font-black">experience.</h2>
        <a
          href="https://www.linkedin.com/in/gianfranco-frau/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border bg-card text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
        >
          <IconLinkedin class="w-4 h-4" />
          My LinkedIn profile
        </a>
      </div>
      <ExperienceList />
    </section>

    <!-- contact -->
    <section>
      <h2 class="text-2xl font-black mb-4 pb-3 border-b border-border">keep in touch.</h2>
      <p class="text-muted-foreground mb-6">
        You can reach me via email, GitHub, or LinkedIn.
      </p>
      <ContactLinks />
    </section>

    <!-- this website -->
    <section>
      <h2 class="text-2xl font-black mb-4 pb-3 border-b border-border">this website.</h2>
      <ul class="space-y-2 text-sm text-muted-foreground list-disc list-inside">
        <li>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-2 hover:no-underline">Astro</a>, Vue islands, and Tailwind CSS.</li>
        <li>Icons from <a href="https://icons.getbootstrap.com" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-2 hover:no-underline">Bootstrap Icons</a>.</li>
        <li>
          <a
            href="https://github.com/GianfrancoFrau/GianfrancoFrau"
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground underline underline-offset-2 hover:no-underline"
          >
            Source code on GitHub
          </a>
        </li>
      </ul>
    </section>

  </div>
</PageLayout>

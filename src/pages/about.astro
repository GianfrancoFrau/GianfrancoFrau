---
import PageLayout from '../layouts/PageLayout.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ContactLinks from '../components/ContactLinks.astro';
import IconLinkedin from '../components/icons/IconLinkedin.astro';
---

<PageLayout title="About">
  <div class="space-y-12">

    <!-- whoami -->
    <section>
      <h2 class="text-2xl font-black mb-4 pb-3 border-b border-border">whoami.</h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p>
          Born in Sardinia, <strong class="text-foreground">1989</strong>. Currently living and working in Cagliari, Sardinia.
        </p>
        <p>
          I've been drawn to technology for as long as I can remember. A childhood split between playing outside and
          Super Nintendo sessions gradually turned into a fascination with how software is made — and then into a
          career building it.
        </p>
      </div>
    </section>

    <!-- experience -->
    <section>
      <div class="flex flex-wrap items-center justify-between gap-4 pb-3 mb-6 border-b border-border">
        <h2 class="text-2xl font-black">experience.</h2>
        <a
          href="https://www.linkedin.com/in/gianfranco-frau/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border bg-card text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
        >
          <IconLinkedin class="w-4 h-4" />
          My LinkedIn profile
        </a>
      </div>
      <ExperienceList />
    </section>

    <!-- contact -->
    <section>
      <h2 class="text-2xl font-black mb-4 pb-3 border-b border-border">keep in touch.</h2>
      <p class="text-muted-foreground mb-6">
        You can reach me via email, GitHub, or LinkedIn.
      </p>
      <ContactLinks />
    </section>

    <!-- this website -->
    <section>
      <h2 class="text-2xl font-black mb-4 pb-3 border-b border-border">this website.</h2>
      <ul class="space-y-2 text-sm text-muted-foreground list-disc list-inside">
        <li>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-2 hover:no-underline">Astro</a>, Vue islands, and Tailwind CSS.</li>
        <li>Icons from <a href="https://icons.getbootstrap.com" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-2 hover:no-underline">Bootstrap Icons</a>.</li>
        <li>
          <a
            href="https://github.com/GianfrancoFrau/GianfrancoFrau"
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground underline underline-offset-2 hover:no-underline"
          >
            Source code on GitHub
          </a>
        </li>
      </ul>
    </section>

  </div>
</PageLayout>

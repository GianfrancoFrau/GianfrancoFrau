---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="404 — Page not found">
  <div class="min-h-screen flex flex-col">
    <SiteHeader />
    <div class="flex-1 flex flex-col items-center justify-center text-center px-4">
      <p class="text-8xl font-black text-border mb-4">404</p>
      <h1 class="text-2xl font-bold mb-2">Page not found</h1>
      <p class="text-muted-foreground mb-8">The page you're looking for doesn't exist.</p>
      <a
        href="/"
        class="px-5 py-2 rounded-lg border border-border bg-card hover:bg-accent hover:text-accent-foreground transition-colors font-medium text-sm"
      >
        Back to home
      </a>
    </div>
  </div>
</BaseLayout>

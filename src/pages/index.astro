---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import AnimatedTitle from '../components/islands/AnimatedTitle.vue'
import SectionHeading from '../components/SectionHeading.astro'
import ShadeText from '../components/ShadeText.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ExperienceList from '../components/ExperienceList.astro'
import ContactLinks from '../components/ContactLinks.astro'
import IconGithub from '../components/icons/IconGithub.astro'
import IconLinkedin from '../components/icons/IconLinkedin.astro'
import IconMail from '../components/icons/IconMail.astro'
import { getCollection } from 'astro:content'

const allProjects = await getCollection('projects')
const projects = allProjects.sort((a, b) => a.data.position - b.data.position)
---

<BaseLayout>
  <div class="min-h-screen flex flex-col">
    <SiteHeader />

    <section class="max-w-3xl mx-auto w-full px-4 pt-24 pb-20">
      <h1 class="text-4xl sm:text-5xl md:text-6xl leading-tight mb-6">
        <ShadeText text="Gianfranco Frau" dot />
      </h1>
      <p class="flex items-baseline text-2xl sm:text-3xl leading-tight mb-6">
        <AnimatedTitle client:load text="A Web Developer" />
        <span class="font-heading-solid text-hero-accent">.</span>
      </p>
      <p class="text-muted-foreground leading-relaxed max-w-xl mb-8">
        I design and build web platforms, APIs, websites and applications.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="#contact" class="btn btn-primary">
          <IconMail class="w-4 h-4" />
          Get in touch
        </a>
        <a
          href="https://github.com/GianfrancoFrau"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          <IconGithub class="w-4 h-4" />
          GitHub
        </a>
      </div>
    </section>

    <main class="flex-1 max-w-3xl mx-auto w-full px-4 pb-20 space-y-16 bg-background/90 backdrop-blur-sm [&>section]:scroll-mt-20">
      <section id="whoami">
        <SectionHeading title="whoami" />
        <p class="text-muted-foreground leading-relaxed">
          Born in Sardinia in <strong class="text-foreground">1989</strong>, I grew up between the
          countryside and afternoons glued to a Super Nintendo. Wondering{' '}
          <strong class="text-foreground">
            <em>how</em>
          </strong>{' '}
          those games worked pulled me toward programming, and from there into a fascination with
          software and the complex systems shaping the world around us. Today I work as a{' '}
          <strong class="text-foreground">backend developer</strong> on the core and APIs of an
          AI-powered customer interaction platform at SmileCX. In this website you can find{' '}
          <strong class="text-foreground">experiments, small apps and projects</strong> built to
          learn something new or just for fun.
        </p>
      </section>

      <section id="experience">
        <SectionHeading title="experience">
          <a
            href="https://www.linkedin.com/in/gianfranco-frau/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            <IconLinkedin class="w-4 h-4" />
            LinkedIn
          </a>
        </SectionHeading>
        <ExperienceList />
      </section>

      <section id="projects">
        <SectionHeading title="projects" />
        <div class="grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>

      <section id="contact">
        <SectionHeading title="contact" />
        <p class="text-muted-foreground mb-6">
          Want to say hello? You can reach me via email, LinkedIn, or GitHub.
        </p>
        <ContactLinks />
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

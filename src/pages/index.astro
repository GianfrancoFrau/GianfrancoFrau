---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnimatedTitle from '../components/islands/AnimatedTitle.vue';
---

<BaseLayout>
  <div class="min-h-screen flex flex-col">
    <SiteHeader />

    <div class="flex-1 flex flex-col items-center justify-center px-4 py-16 text-center">
      <h1 class="font-display text-6xl sm:text-7xl font-bold leading-none tracking-tight mb-6">
        Gianfranco<br />Frau
      </h1>

      <div class="text-lg font-black mb-1">
        <AnimatedTitle client:load />
      </div>

      <p class="text-muted-foreground text-sm mb-8">
        Cagliari, Sardinia
      </p>

      <nav class="flex flex-wrap justify-center gap-2 mb-8 text-sm">
        <a href="/about" class="px-5 py-2 rounded-lg border border-border bg-card hover:bg-accent hover:text-accent-foreground transition-colors font-medium">
          About
        </a>
        <a href="/projects" class="px-5 py-2 rounded-lg border border-border bg-card hover:bg-accent hover:text-accent-foreground transition-colors font-medium">
          Projects
        </a>
        <a href="/blog" class="px-5 py-2 rounded-lg border border-border bg-card hover:bg-accent hover:text-accent-foreground transition-colors font-medium">
          Blog
        </a>
      </nav>

    </div>
    <SiteFooter />
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnimatedTitle from '../components/islands/AnimatedTitle.vue';
---

<BaseLayout>
  <div class="min-h-screen flex flex-col">
    <SiteHeader />

    <div class="flex-1 flex flex-col items-center justify-center px-6 py-16 text-center">

      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl font-bold leading-[0.88] tracking-tight mb-10 text-foreground/75">
        Gianfranco<br />
        <span>Frau<span style="color: var(--hero-accent, oklch(0.62 0.17 55));">.</span></span>
      </h1>

      <div class="text-xl text-muted-foreground mb-14">
        <AnimatedTitle client:load />
      </div>

      <nav class="flex items-center gap-3">
        <a href="/about" class="px-5 py-2.5 text-sm font-medium rounded-full border border-border text-muted-foreground hover:text-foreground hover:border-foreground/30 transition-all duration-200">
          About
        </a>
        <a href="/projects" class="group flex items-center gap-1.5 px-5 py-2.5 text-sm font-medium rounded-full bg-foreground text-background hover:opacity-90 transition-opacity duration-200">
          Projects
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-200" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </nav>
    </div>
    <SiteFooter />
  </div>
</BaseLayout>

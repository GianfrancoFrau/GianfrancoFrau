---
import '../styles/global.css'
import { DEFAULT_PALETTE, PALETTES, PALETTE_STORAGE_KEY } from '../data/palettes'

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = 'Gianfranco Frau',
  description = 'Backend web developer based in Cagliari, Sardinia.',
  image = '/android-chrome-512x512.png'
} = Astro.props

const ogImage = new URL(image, Astro.site)

const pageTitle = title === 'Gianfranco Frau' ? title : `${title} — Gianfranco Frau`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const paletteIds = PALETTES.map((palette) => palette.id)
---

<!doctype html>
<html lang="en" class="dark" data-palette={DEFAULT_PALETTE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      Anti-FOUC: dark and the default palette are hardcoded on <html>.
      The script only applies what the user explicitly saved.
    -->
    <script is:inline define:vars={{ paletteIds, paletteKey: PALETTE_STORAGE_KEY }}>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.remove('dark')
        }
        const palette = localStorage.getItem(paletteKey)
        if (paletteIds.includes(palette)) {
          document.documentElement.dataset.palette = palette
        }
      } catch (_) {}
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gianfranco Frau" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Bungee&family=Bungee+Shade&family=Space+Grotesk:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/date';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const formattedDate = formatDate(pubDate);
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col">
    <SiteHeader />
    <main class="flex-1 max-w-3xl mx-auto w-full px-4 py-10">
      <article>
        <header class="mb-8 space-y-3">
          <h1 class="text-3xl font-black">{title}</h1>
          <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {updatedDate && (
              <span>
                · Updated{' '}
                <time datetime={updatedDate.toISOString()}>
                  {formatDate(updatedDate)}
                </time>
              </span>
            )}
          </div>
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-secondary text-secondary-foreground font-medium">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <div class="prose prose-zinc dark:prose-invert max-w-none">
          <slot />
        </div>
      </article>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

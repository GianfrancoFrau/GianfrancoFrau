---
import IconExternal from './icons/IconExternal.astro'
import IconGithub from './icons/IconGithub.astro'

interface Props {
  url?: string
  repo?: string
}

const { url, repo } = Astro.props
const linkClass =
  'inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground border border-transparent hover:border-border px-2 py-1 transition-colors'
---

{
  (url || repo) && (
    <div class="flex gap-4">
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" class={linkClass}>
          <IconExternal class="w-3 h-3" />
          Website
        </a>
      )}
      {repo && (
        <a href={repo} target="_blank" rel="noopener noreferrer" class={linkClass}>
          <IconGithub class="w-3 h-3" />
          Source
        </a>
      )}
    </div>
  )
}

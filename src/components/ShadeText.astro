---
interface Props {
  text: string
  /** Appends an accent-colored dot, e.g. "Gianfranco Frau." */
  dot?: boolean
  class?: string
}

const { text, dot = false, class: className } = Astro.props
---

{/* One line on purpose: a line break before the dot would render as a space */}
<!-- prettier-ignore -->
<span class:list={['font-heading', className]}>{text}{dot && <span class="text-hero-accent">.</span>}</span>

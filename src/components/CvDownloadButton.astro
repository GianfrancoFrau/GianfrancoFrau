---
import IconDownload from './icons/IconDownload.astro';

interface Props {
  label?: string;
  class?: string;
}

const { label = 'Download CV', class: className } = Astro.props;
---

<a
  href="/cv/gianfranco-frau-cv.pdf"
  download
  class:list={[
    'inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border bg-card text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors',
    className,
  ]}
>
  <IconDownload class="w-4 h-4" />
  {label}
</a>

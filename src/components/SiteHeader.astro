---
import ThemeToggle from './islands/ThemeToggle.vue'
import IconMenu from './icons/IconMenu.astro'
import ShadeText from './ShadeText.astro'
import PalettePicker from './PalettePicker.astro'

// Labels mirror the home section headings and their anchors
const sections = ['whoami', 'experience', 'projects', 'contact']
---

<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/80 backdrop-blur-sm">
  <div class="max-w-3xl mx-auto w-full px-4 h-14 flex items-center justify-between gap-4">
    <a href="/" class="text-xl hover:opacity-80 transition-opacity">
      <ShadeText text="GF" dot />
      <span class="sr-only"> home</span>
    </a>

    <div class="flex items-center gap-4">
      <nav aria-label="Main" class="hidden sm:block">
        <ul class="flex items-center gap-4 font-mono text-sm">
          {sections.map((label) => (
            <li>
              <a
                href={`/#${label}`}
                class="text-muted-foreground hover:text-foreground transition-colors"
              >
                <span class="opacity-80">~/</span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="flex items-center gap-1">
        <PalettePicker />
        <ThemeToggle client:load />
      </div>
      <button
        type="button"
        popovertarget="mobile-nav"
        aria-label="Open menu"
        class="sm:hidden inline-flex items-center justify-center w-8 h-8 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
      >
        <IconMenu class="w-5 h-5" />
      </button>
    </div>
  </div>
</header>

{/* `open:block` keeps the menu hidden where the Popover API is unsupported */}
<nav
  id="mobile-nav"
  popover
  aria-label="Main"
  class="hidden open:block fixed top-16 right-4 bottom-auto left-auto m-0 w-56 p-2 border border-border bg-popover text-popover-foreground shadow-lg backdrop:bg-background/60"
>
  <ul class="flex flex-col font-mono text-sm">
    {sections.map((label) => (
      <li>
        <a
          href={`/#${label}`}
          class="block px-3 py-2 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
        >
          <span class="opacity-80">~/</span>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Popovers only light-dismiss on outside clicks: close it when a link is followed
  const mobileNav = document.getElementById('mobile-nav')
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileNav.hidePopover())
  })
</script>

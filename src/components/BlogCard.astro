---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/blog/${post.id}`} class="block space-y-2 p-4 -mx-4 rounded-lg hover:bg-accent transition-colors">
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-semibold group-hover:text-accent-foreground transition-colors">{title}</h3>
      <time
        datetime={pubDate.toISOString()}
        class="text-xs text-muted-foreground shrink-0 mt-0.5"
      >
        {formattedDate}
      </time>
    </div>

    <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">{description}</p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-0.5">
        {tags.map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-secondary text-secondary-foreground">
            {tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>

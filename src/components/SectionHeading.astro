---
interface Props {
  title: string
}

const { title } = Astro.props
---

{/* Solid Bungee: at this size the Bungee Shade outline and shadow blur together */}
<div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-border">
  <h2 class="flex items-baseline gap-2 text-xl leading-snug">
    <span class="font-mono text-muted-foreground" aria-hidden="true">
      $
    </span>
    <span class="font-heading-solid">{title}</span>
  </h2>
  <slot />
</div>

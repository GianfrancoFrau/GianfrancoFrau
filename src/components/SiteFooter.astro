---
import pkg from '../../package.json';

const now = new Date();
const lastUpdate = `${now.getFullYear()}/${String(now.getMonth() + 1).padStart(2, '0')}/${String(now.getDate()).padStart(2, '0')}`;
---

<footer class="border-t border-border mt-auto py-6">
  <div class="max-w-3xl mx-auto w-full px-4 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-muted-foreground">
    <span>© {now.getFullYear()} Gianfranco Frau</span>
    <span>v{pkg.version} · last update {lastUpdate}</span>
  </div>
</footer>

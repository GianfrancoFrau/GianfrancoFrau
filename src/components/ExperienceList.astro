---
const experience = [
  { company: 'SmileCX', role: 'Backend Development Lead', period: '04/2024 – today' },
  {
    company: 'StartupItalia',
    role: 'Full Stack Developer',
    period: '08/2023 – 04/2024',
    detail: '8 months'
  },
  {
    company: 'Vivocha',
    role: 'Frontend Developer',
    period: '01/2016 – 08/2023',
    detail: '7 years & 8 months'
  },
  {
    company: 'Glaamy',
    role: 'Full Stack Developer',
    period: '03/2014 – 01/2016',
    detail: '1 year & 11 months'
  }
]
---

<ol class="divide-y divide-border">
  {experience.map(({ company, role, period, detail }) => (
    <li class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 py-4 first:pt-0">
      <div>
        <p class="font-semibold">{company}</p>
        <p class="text-sm text-muted-foreground">{role}</p>
      </div>
      <p class="text-xs text-muted-foreground sm:text-right shrink-0">
        {period}
        {detail && <span class="block">{detail}</span>}
      </p>
    </li>
  ))}
</ol>

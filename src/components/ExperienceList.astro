---
const experience = [
  {
    company: 'SmileCX',
    role: 'Backend Development Lead',
    period: '04/2024 – today',
  },
  {
    company: 'StartupItalia',
    role: 'Full Stack Developer',
    period: '08/2023 – 04/2024',
    detail: '8 months',
  },
  {
    company: 'Vivocha',
    role: 'Frontend Developer',
    period: '01/2016 – 08/2023',
    detail: '7 years & 8 months',
  },
  {
    company: 'Glaamy',
    role: 'Full Stack Developer',
    period: '03/2014 – 01/2016',
    detail: '1 year & 11 months',
  },
];
---

<ul class="space-y-6">
  {experience.map(({ company, role, period, detail }) => (
    <li class="flex gap-4">
      <div class="w-2 h-2 mt-2.5 rounded-full bg-border shrink-0" />
      <div>
        <p class="text-xs text-muted-foreground mb-0.5">
          {period}
          {detail && <span class="ml-1 opacity-70">· {detail}</span>}
        </p>
        <p class="font-semibold">{company}</p>
        <p class="text-sm text-muted-foreground">{role}</p>
      </div>
    </li>
  ))}
</ul>

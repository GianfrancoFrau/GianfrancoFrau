---
const skills = [
  {
    size: 'big',
    items: ['HTML', 'CSS', 'JavaScript'],
  },
  {
    size: 'md',
    items: ['TypeScript', 'Node.js'],
  },
  {
    size: 'sm',
    items: ['Vue', 'React', 'Angular', 'Next.js'],
  },
  {
    size: 'xs',
    items: ['Astro', 'Git', 'Docker'],
  },
];
---

<div class="space-y-1.5">
  {skills.map(({ size, items }) => (
    <div class="flex flex-wrap gap-1">
      {items.map((name) => (
        <span
          class:list={[
            'skill-' + size,
            'flex-1 min-w-fit rounded-lg border border-border bg-secondary text-secondary-foreground text-center uppercase tracking-wide',
          ]}
        >
          {name}
        </span>
      ))}
    </div>
  ))}
</div>
